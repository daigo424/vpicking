.venv/
venv/

__pycache__/
*.pyc
*.pyo
*.pyd

.DS_Store
Thumbs.db

build/
dist/
*.egg-info/

# ROS2/colcon build artifacts (e.g. edge/workspace/{install,log}/)
install/
log/
*.log

.*/
!.github/

.coverage
htmlcov/

# lcov/genhtmlカバレッジ生成物 (edge/workspace/.vscode/tasks.json の
# "ROS2: Run Coverage" / "ROS2: Generate Coverage Report (Current Test Package)" が生成)
edge/workspace/coverage/

*.swp

# Gazebo GUI等のクラッシュ時にOSが吐くコアダンプ(core_pattern依存でcwd直下に落ちる)
core
core.*

tmp/

.env

data/*
runs/*
docs/**/*.bkp

# 学習のたびに結果が変わる都合上、動作確認済みのモデル重み・キーポイント定義だけは
# バージョンディレクトリ単位(data/<camera>/models/<VER>/)で再現性のためgit管理下に置く。
# 親ディレクトリが除外されたままだとgitignoreは子の再包含ルールへ辿り着けないため、
# data/<camera>/自体をいったん再包含し、その配下を再度除外してからmodels/だけを再包含する。
!data/overhead-camera/
data/overhead-camera/*
!data/overhead-camera/models/

!data/wrist-camera/
data/wrist-camera/*
!data/wrist-camera/models/

# YOLOの学習成果物・自動ダウンロードされる事前学習済み重み
# (train_yolo_pose.pyが/workspace=edge/workspace直下に生成・取得する)
edge/workspace/runs/
edge/workspace/*.pt

# edge/workspace/ で作ったドキュメントファイルは全てスルー
edge/workspace/**/*.pdf
edge/workspace/**/*.gv

# 開発環境として必要な設定ディレクトリとファイル
!.devcontainer
!edge/workspace/.vscode/
